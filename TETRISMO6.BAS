40 ON ERROR GOTO 200
50 OPEN "I",#1,"0:TETRIS.SCO"
60 FOR I=0 TO 5:INPUT #1,V:POKE &H7403+I,V:NEXT I
70 ON ERROR GOTO 0:CLOSE
80 EXEC &H7400
90 OPEN "O",#1,"0:TETRIS.SCO"
100 FOR I=0 TO 5:PRINT #1,PEEK(&H7403+I):NEXT I
110 CLOSE
120 SCREEN 7,0,0:CLS:PRINT "MEILLEURS SCORES SAUVEGARDES":END
200 RESUME 70
